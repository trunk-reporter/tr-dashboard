# Database
POSTGRES_USER=trengine
POSTGRES_PASSWORD=change-me
POSTGRES_DB=trengine

# tr-engine ingest source (required). tr-engine exits at startup, before it
# prints the bootstrap admin key, unless at least one of MQTT_BROKER_URL,
# TR_DIR or WATCH_DIR is set. The compose files pass this file to tr-engine
# (env_file), so any other tr-engine setting (see tr-engine's sample.env) can
# go here too.
#
# The MQTT broker trunk-recorder's MQTT Status plugin publishes to, e.g.
# tcp://192.168.1.50:1883 (use a hostname or IP the tr-engine container can
# reach, not localhost):
MQTT_BROKER_URL=
MQTT_USERNAME=
MQTT_PASSWORD=
# Topic filters matching the plugin's topic/unit_topic/message_topic prefixes
# (default "#", everything):
# MQTT_TOPICS=trunk-recorder/#
#
# Instead of (or as well as) MQTT, uncomment the matching volume for
# tr-engine in the compose file and set:
# TR_DIR=/tr-config      # trunk-recorder directory with config.json (auto-discovery)
# WATCH_DIR=/tr-audio    # trunk-recorder's audio directory (completed calls only)

# Hostnames (used by Traefik labels or Caddy site address)
DASHBOARD_HOST=dashboard.example.com
ENGINE_HOST=api.example.com

# Traefik cert resolver name (traefik example only)
CERT_RESOLVER=letsencrypt

# Timezone
TZ=America/New_York

# Access control is not configured here: tr-engine keeps API keys and the
# anonymous access policy in its database. See README.md "Authentication".
