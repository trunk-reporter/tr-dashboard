# tr-engine connection for Vite dev proxy (base URL, no path)
# Required to enable the dev proxy; omit if using VITE_API_BASE for direct connection.
# Example: TR_ENGINE_URL=http://localhost:8080 (tr-engine's default port)
TR_ENGINE_URL=

# Frontend API base URL (including /api/v1 path)
# Default: /api/v1 (relative, requires reverse proxy like Caddy/nginx)
# Set to an absolute URL to connect directly without a reverse proxy.
# Works both as a build-time var (npm run build) and as a Docker runtime
# environment variable when using the pre-built ghcr.io image.
# Example: VITE_API_BASE=http://192.168.1.100:8080/api/v1
VITE_API_BASE=

# Disable the built-in update check (set to "true" to disable)
VITE_DISABLE_UPDATE_CHECK=

# Dev proxy only (npm run dev): an API key that the Vite proxy adds to
# requests that carry no Authorization header, so a local dashboard works
# against a keyed tr-engine without pasting a key. A key entered in the
# dashboard always wins. Use a listen key, never the bootstrap admin key:
# whoever gets a request through the proxy acts with this key. The dev server
# listens on all interfaces, so the key is added only to same-origin requests
# from this machine (not to other devices on the network, nor to requests
# other sites in your browser make); `npm run preview` never adds it.
# Never do this in a deployment: a proxy that adds a key to visitors' requests
# gives that key to every visitor. Deployed dashboards ask for a key in the
# browser, or browse under the engine's anonymous access policy.
TR_API_KEY=
